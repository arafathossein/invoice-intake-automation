# ── Extraction ───────────────────────────────────────────────
# Leave LLM_BASE_URL empty to use the built-in rule-based extractor (no API key needed).
#
# OpenAI:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini
#
# Local model with Ollama (data never leaves your machine):
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_API_KEY=
#   LLM_MODEL=llama3.1:8b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Policy ───────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.90
AUTO_POST_LIMIT=2000

# ── Service ──────────────────────────────────────────────────
# If set, callers must send this value in an X-API-Key header.
SERVICE_API_KEY=
VENDORS_CSV=config/vendors.csv
DATA_DIR=data

# ── Xero (optional: posting auto-approved bills) ─────────────
# Retry-safe: the service looks a bill up before creating it and sends an idempotency key.
XERO_TENANT_ID=
# Access tokens expire after 30 minutes. Point XERO_TOKEN_FILE at a file your OAuth
# refresher rewrites (read on every request), or set XERO_ACCESS_TOKEN for a quick test.
XERO_TOKEN_FILE=
XERO_ACCESS_TOKEN=
XERO_BILL_STATUS=DRAFT
XERO_ACCOUNT_CODE=
